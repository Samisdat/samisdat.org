{
  "plugins": ["react", "nextjs"],
  "ignorePatterns": [
    "**/Buildings/**",
    "**/codesandboxes/**",
    "**/generated/**",
    "**/dist/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.stories.*"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 15
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 250,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "max-nested-callbacks": [
      "error",
      {
        "max": 4
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/codeprose/src/scholion/runtime/state.ts"],
