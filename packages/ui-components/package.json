{
  "name": "@samisdat/ui-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*/index.tsx",
      "import": "./src/*/index.tsx"
    },
    "./Demo/DemoContext": {
      "types": "./src/Demo/DemoContext.tsx",
      "import": "./src/Demo/DemoContext.tsx"
    },
    "./Demo/Animations/*": {
      "types": "./src/Demo/Animations/*.tsx",
      "import": "./src/Demo/Animations/*.tsx"
    },
    "./Demo/Animations/Compare": {
      "types": "./src/Demo/Animations/Compare/index.tsx",
      "import": "./src/Demo/Animations/Compare/index.tsx"
    },
    "./Demo/Parallax/*": {
      "types": "./src/Demo/Parallax/*.tsx",
      "import": "./src/Demo/Parallax/*.tsx"
    },
    "./style/globalStyle": {
      "types": "./src/style/globalstyle.ts",
      "import": "./src/style/globalstyle.ts"
    },
    "./globalStyle": {
      "types": "./src/style/globalstyle.ts",
      "import": "./src/style/globalstyle.ts"
    },
    "./utils/shikiTheme": {
      "types": "./src/utils/shikiTheme/index.ts",
      "import": "./src/utils/shikiTheme/index.ts"
    },
    "./tokens/themes": {
      "types": "./src/tokens/themes.ts",
      "import": "./src/tokens/themes.ts"
    },
    "./tokens/space": {
      "types": "./src/tokens/space/index.ts",
      "import": "./src/tokens/space/index.ts"
    }
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@fortawesome/fontawesome-svg-core": "catalog:",
    "@fortawesome/free-regular-svg-icons": "catalog:",
    "@fortawesome/free-solid-svg-icons": "catalog:",
    "@fortawesome/react-fontawesome": "catalog:",
    "@linaria/core": "catalog:",
    "@linaria/react": "catalog:",
    "@samisdat/color-scheme": "workspace:*",
    "@samisdat/tools": "workspace:*",
    "culori": "^4.0.2",
    "fs-extra": "catalog:",
    "normalize.css": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-shiki": "^0.11.1",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-multiline-arrays": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "typescript": "catalog:"
  }
}
