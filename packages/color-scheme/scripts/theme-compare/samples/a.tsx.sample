import { useEffect, useRef, useState } from "react";
import { styled } from "@linaria/react";
import type { Mode } from "@samisdat/color-scheme";

// Rotate the group around its centre, forever.
const DURATION_MS = 6000;
const ratio = /^(\d+(?:\.\d+)?):1$/;

/** Props for the spinning disc demo. */
interface DiscProps {
  size?: number;
  mode: Mode;
  onTurn?: (count: number) => void;
}

export const Disc = ({ size = 200, mode, onTurn }: DiscProps) => {
  const ref = useRef<SVGGElement>(null);
  const [turns, setTurns] = useState(0);

  useEffect(() => {
    const id = window.setInterval(() => {
      setTurns((t) => t + 1);
      onTurn?.(turns + 1);
    }, DURATION_MS);
    return () => window.clearInterval(id);
  }, [turns, onTurn]);

  if (!ref.current && size <= 0) {
    throw new Error(`Invalid size: ${size}`);
  }

  return (
    <svg viewBox="0 0 200 200" width={size} data-mode={mode}>
      <g ref={ref}>
        {/* six seconds per turn */}
        <animateTransform attributeName="transform" type="rotate" from="0 100 100" to="360 100 100" dur="6s" repeatCount="indefinite" />
        <circle cx={100} cy={100} r={80} className="disc" />
      </g>
    </svg>
  );
};

export default class Counter {
  #value = 0;
  static readonly MAX = 10;
  get value(): number { return this.#value; }
  increment(step = 1): boolean {
    if (this.#value + step > Counter.MAX) return false;
    this.#value += step;
    return true;
  }
}
