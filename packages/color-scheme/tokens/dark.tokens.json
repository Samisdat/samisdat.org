{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{color.aubergine.900}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "emphasis": {
      "$value": "{color.aubergine.950}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "raised": {
      "$value": "{color.aubergine.800}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "subtle": {
      "$value": "{color.aubergine.700}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "muted": {
      "$value": "{color.aubergine.600}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only",
          "exempt": "no text on this surface; border.* tokens now own all border and scroll-progress uses"
        }
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.ivory.200}"
    },
    "emphasis": {
      "$value": "{color.ivory.100}"
    },
    "secondary": {
      "$value": "{color.ivory.300}"
    },
    "subtle": {
      "$value": "{color.ivory.500}"
    },
    "muted": {
      "$value": "{color.ivory.600}"
    }
  },
  "ink": {
    "$type": "color",
    "red": {
      "$value": "{color.red.500}",
      "$extensions": {
        "org.samisdat.a11y": {
          "apcaMin": 40,
          "apcaReason": "Bewusst kräftiges Rot für keyword; Entscheidung gegen Lachs-Ton, Lc ≈ 44"
        }
      }
    },
    "orange": {
      "$value": "{color.orange.400}"
    },
    "yellow": {
      "$value": "{color.yellow.300}"
    },
    "green": {
      "$value": "{color.green.400}"
    },
    "teal": {
      "$value": "{color.teal.400}"
    },
    "cyan": {
      "$value": "{color.cyan.400}"
    },
    "blue": {
      "$value": "{color.blue.400}"
    },
    "purple": {
      "$value": "{color.purple.400}"
    },
    "pink": {
      "$value": "{color.pink.300}"
    },
    "comment": {
      "$value": "{color.periwinkle.300}"
    }
  },
  "status": {
    "$type": "color",
    "danger": {
      "$value": "{ink.red}"
    },
    "warning": {
      "$value": "{ink.orange}"
    },
    "success": {
      "$value": "{ink.green}"
    },
    "info": {
      "$value": "{ink.blue}"
    }
  },
  "border": {
    "$type": "color",
    "muted": {
      "$value": "{surface.muted}"
    },
    "default": {
      "$value": "{color.aubergine.500}"
    },
    "strong": {
      "$value": "{color.ivory.600}"
    },
    "focus": {
      "$value": "{ink.teal}"
    }
  },
  "selection": {
    "$type": "color",
    "$value": "{color.aubergine.800}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "neutral-only"
      }
    }
  },
  "highlight": {
    "$type": "color",
    "$value": "{color.aubergine.800}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "neutral-only"
      }
    }
  },
  "syntax": {
    "$type": "color",
    "foreground": {
      "$value": "{text.default}"
    },
    "background": {
      "$value": "{surface.emphasis}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "comment": {
      "$value": "{ink.comment}",
      "$extensions": {
        "org.samisdat.syntax": {
          "fontStyle": "italic"
        }
      }
    },
    "keyword": {
      "$value": "{ink.red}"
    },
    "string": {
      "$value": "{ink.green}"
    },
    "string-special": {
      "$value": "{ink.cyan}"
    },
    "number": {
      "$value": "{ink.green}"
    },
    "constant": {
      "$value": "{ink.green}"
    },
    "function": {
      "$value": "{ink.blue}"
    },
    "type": {
      "$value": "{ink.cyan}"
    },
    "variable": {
      "$value": "{text.default}"
    },
    "parameter": {
      "$value": "{ink.yellow}"
    },
    "property": {
      "$value": "{ink.teal}"
    },
    "tag": {
      "$value": "{ink.pink}"
    },
    "tag-attribute": {
      "$value": "{ink.purple}"
    },
    "operator": {
      "$value": "{text.secondary}"
    },
    "punctuation": {
      "$value": "{text.secondary}"
    },
    "diff-plus": {
      "$value": "{ink.green}"
    },
    "diff-minus": {
      "$value": "{ink.red}"
    }
  },
  "terminal": {
    "$type": "color",
    "$description": "ANSI-Palette (0-7 normal, 8-15 bright), geteilt für zsh/herdr/nvim (ADR 0019). Aliase auf bestehende Ebene-2-Werte, keine neuen Primitiven. black/white folgen dem jeweils dunkelsten/hellsten Neutralton des Modes (surface im Dark Mode, text im Light Mode); bright-Varianten der Bunttöne nutzen, wo verfügbar, einen zweiten Ink-Ton derselben Farbfamilie, sonst denselben Ton wie normal.",
    "ansi0": {
      "$value": "{surface.emphasis}",
      "$description": "black"
    },
    "ansi1": {
      "$value": "{ink.red}",
      "$description": "red"
    },
    "ansi2": {
      "$value": "{ink.green}",
      "$description": "green"
    },
    "ansi3": {
      "$value": "{ink.yellow}",
      "$description": "yellow"
    },
    "ansi4": {
      "$value": "{ink.blue}",
      "$description": "blue"
    },
    "ansi5": {
      "$value": "{ink.purple}",
      "$description": "magenta"
    },
    "ansi6": {
      "$value": "{ink.cyan}",
      "$description": "cyan"
    },
    "ansi7": {
      "$value": "{text.default}",
      "$description": "white"
    },
    "ansi8": {
      "$value": "{surface.default}",
      "$description": "bright black"
    },
    "ansi9": {
      "$value": "{ink.orange}",
      "$description": "bright red"
    },
    "ansi10": {
      "$value": "{ink.green}",
      "$description": "bright green (keine zweite Grün-Ink verfügbar, identisch mit ansi2)"
    },
    "ansi11": {
      "$value": "{ink.yellow}",
      "$description": "bright yellow (keine zweite Gelb-Ink verfügbar, identisch mit ansi3)"
    },
    "ansi12": {
      "$value": "{ink.blue}",
      "$description": "bright blue (keine zweite Blau-Ink verfügbar, identisch mit ansi4)"
    },
    "ansi13": {
      "$value": "{ink.pink}",
      "$description": "bright magenta"
    },
    "ansi14": {
      "$value": "{ink.teal}",
      "$description": "bright cyan"
    },
    "ansi15": {
      "$value": "{text.emphasis}",
      "$description": "bright white"
    }
  }
}
