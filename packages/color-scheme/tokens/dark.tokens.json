{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{color.aubergine.900}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "emphasis": {
      "$value": "{color.aubergine.950}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "raised": {
      "$value": "{color.aubergine.800}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "ink"
        }
      }
    },
    "subtle": {
      "$value": "{color.aubergine.700}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "muted": {
      "$value": "{color.aubergine.600}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only",
          "exempt": "no text on this surface; border.* tokens now own all border and scroll-progress uses"
        }
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.ivory.200}"
    },
    "emphasis": {
      "$value": "{color.ivory.100}"
    },
    "secondary": {
      "$value": "{color.ivory.300}"
    },
    "subtle": {
      "$value": "{color.ivory.500}"
    },
    "muted": {
      "$value": "{color.ivory.600}"
    }
  },
  "ink": {
    "$type": "color",
    "ruby": {
      "$value": "{color.red.400}"
    },
    "copper": {
      "$value": "{color.orange.400}"
    },
    "gold": {
      "$value": "{color.yellow.300}"
    },
    "jade": {
      "$value": "{color.green.400}"
    },
    "turquoise": {
      "$value": "{color.teal.400}"
    },
    "steel": {
      "$value": "{color.cyan.400}"
    },
    "sapphire": {
      "$value": "{color.blue.400}"
    },
    "amethyst": {
      "$value": "{color.purple.400}"
    },
    "rose": {
      "$value": "{color.pink.300}"
    },
    "lapis": {
      "$value": "{color.periwinkle.300}"
    }
  },
  "status": {
    "$type": "color",
    "danger": {
      "$value": "{ink.ruby}"
    },
    "warning": {
      "$value": "{ink.copper}"
    },
    "success": {
      "$value": "{ink.jade}"
    },
    "info": {
      "$value": "{ink.sapphire}"
    }
  },
  "border": {
    "$type": "color",
    "muted": {
      "$value": "{surface.muted}"
    },
    "default": {
      "$value": "{color.aubergine.500}"
    },
    "strong": {
      "$value": "{color.ivory.600}"
    },
    "focus": {
      "$value": "{ink.turquoise}"
    }
  },
  "selection": {
    "$type": "color",
    "$value": "{color.aubergine.800}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "ink"
      }
    }
  },
  "highlight": {
    "$type": "color",
    "$value": "{color.aubergine.800}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "ink"
      }
    }
  },
  "diff": {
    "$type": "color",
    "$description": "Opake nvim-Diff-Hintergründe (DiffAdd/DiffDelete, DiffChange/DiffText), ersetzen tokyonights alpha-blendete Defaults. textTier neutral-only wie selection/highlight.",
    "add": {
      "$value": "{color.green.800}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "delete": {
      "$value": "{color.red.800}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "change": {
      "$value": "{color.blue.800}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    }
  },
  "syntax": {
    "$type": "color",
    "foreground": {
      "$value": "{text.default}"
    },
    "background": {
      "$value": "{surface.emphasis}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "comment": {
      "$value": "{ink.lapis}",
      "$extensions": {
        "org.samisdat.syntax": {
          "fontStyle": "italic"
        }
      }
    },
    "keyword": {
      "$value": "{ink.ruby}"
    },
    "string": {
      "$value": "{ink.jade}"
    },
    "string-special": {
      "$value": "{ink.steel}"
    },
    "number": {
      "$value": "{ink.jade}"
    },
    "constant": {
      "$value": "{ink.jade}"
    },
    "function": {
      "$value": "{ink.sapphire}"
    },
    "type": {
      "$value": "{ink.steel}"
    },
    "variable": {
      "$value": "{text.default}"
    },
    "parameter": {
      "$value": "{ink.gold}"
    },
    "property": {
      "$value": "{ink.turquoise}"
    },
    "tag": {
      "$value": "{ink.rose}"
    },
    "tag-attribute": {
      "$value": "{ink.amethyst}"
    },
    "operator": {
      "$value": "{text.secondary}"
    },
    "punctuation": {
      "$value": "{text.secondary}"
    },
    "diff-plus": {
      "$value": "{ink.jade}"
    },
    "diff-minus": {
      "$value": "{ink.ruby}"
    }
  },
  "terminal": {
    "$type": "color",
    "$description": "ANSI-Palette (0-7 normal, 8-15 bright), geteilt für zsh/herdr/nvim (ADR 0019). Aliase auf bestehende Ebene-2-Werte, keine neuen Primitiven. black/white folgen dem jeweils dunkelsten/hellsten Neutralton des Modes (surface im Dark Mode, text im Light Mode); bright-Varianten der Bunttöne nutzen, wo verfügbar, einen zweiten Ink-Ton derselben Farbfamilie, sonst denselben Ton wie normal.",
    "ansi0": {
      "$value": "{surface.emphasis}",
      "$description": "black"
    },
    "ansi1": {
      "$value": "{ink.ruby}",
      "$description": "red"
    },
    "ansi2": {
      "$value": "{ink.jade}",
      "$description": "green"
    },
    "ansi3": {
      "$value": "{ink.gold}",
      "$description": "yellow"
    },
    "ansi4": {
      "$value": "{ink.sapphire}",
      "$description": "blue"
    },
    "ansi5": {
      "$value": "{ink.amethyst}",
      "$description": "magenta"
    },
    "ansi6": {
      "$value": "{ink.steel}",
      "$description": "cyan"
    },
    "ansi7": {
      "$value": "{text.default}",
      "$description": "white"
    },
    "ansi8": {
      "$value": "{surface.muted}",
      "$description": "bright black (muted/dim foreground used by many TUI tools, e.g. shell completion descriptions; needs real contrast against background, not a near-identical surface tone)"
    },
    "ansi9": {
      "$value": "{ink.copper}",
      "$description": "bright red"
    },
    "ansi10": {
      "$value": "{ink.jade}",
      "$description": "bright green (keine zweite Grün-Ink verfügbar, identisch mit ansi2)"
    },
    "ansi11": {
      "$value": "{ink.gold}",
      "$description": "bright yellow (keine zweite Gelb-Ink verfügbar, identisch mit ansi3)"
    },
    "ansi12": {
      "$value": "{ink.sapphire}",
      "$description": "bright blue (keine zweite Blau-Ink verfügbar, identisch mit ansi4)"
    },
    "ansi13": {
      "$value": "{ink.rose}",
      "$description": "bright magenta"
    },
    "ansi14": {
      "$value": "{ink.turquoise}",
      "$description": "bright cyan"
    },
    "ansi15": {
      "$value": "{text.emphasis}",
      "$description": "bright white"
    }
  }
}
