{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{color.linen.200}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "emphasis": {
      "$value": "{color.linen.600}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "raised": {
      "$value": "{color.linen.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "subtle": {
      "$value": "{color.linen.400}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "muted": {
      "$value": "{color.linen.500}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only",
          "exempt": "no text on this surface; border.* tokens now own all border and scroll-progress uses"
        }
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.aubergine.900}"
    },
    "emphasis": {
      "$value": "{color.aubergine.950}"
    },
    "secondary": {
      "$value": "{color.aubergine.800}"
    },
    "subtle": {
      "$value": "{color.aubergine.700}"
    },
    "muted": {
      "$value": "{color.linen.800}"
    }
  },
  "ink": {
    "$type": "color",
    "ruby": {
      "$value": "{color.red.700}"
    },
    "copper": {
      "$value": "{color.orange.700}"
    },
    "gold": {
      "$value": "{color.yellow.700}"
    },
    "jade": {
      "$value": "{color.green.700}"
    },
    "turquoise": {
      "$value": "{color.teal.700}"
    },
    "steel": {
      "$value": "{color.cyan.700}"
    },
    "sapphire": {
      "$value": "{color.blue.700}"
    },
    "amethyst": {
      "$value": "{color.purple.700}"
    },
    "rose": {
      "$value": "{color.pink.700}"
    },
    "lapis": {
      "$value": "{color.periwinkle.700}"
    }
  },
  "status": {
    "$type": "color",
    "danger": {
      "$value": "{ink.ruby}"
    },
    "warning": {
      "$value": "{ink.copper}"
    },
    "success": {
      "$value": "{ink.jade}"
    },
    "info": {
      "$value": "{ink.sapphire}"
    }
  },
  "border": {
    "$type": "color",
    "muted": {
      "$value": "{surface.muted}"
    },
    "default": {
      "$value": "{color.linen.800}"
    },
    "strong": {
      "$value": "{color.aubergine.700}"
    },
    "focus": {
      "$value": "{ink.turquoise}"
    }
  },
  "selection": {
    "$type": "color",
    "$value": "{color.purple.400}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "neutral-only"
      }
    }
  },
  "highlight": {
    "$type": "color",
    "$value": "{color.periwinkle.100}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "ink"
      }
    }
  },
  "nvim": {
    "$type": "color",
    "$description": "Nur für Mode-Parität: das nvim-Theme wird ausschließlich in Dark erzeugt. Light-Werte sind Aliase auf highlight/selection.",
    "cursorline": {
      "$value": "{highlight}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "ink"
        }
      }
    },
    "visual": {
      "$value": "{selection}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    }
  },
  "diff": {
    "$type": "color",
    "$description": "Opake nvim-Diff-Hintergründe (DiffAdd/DiffDelete, DiffChange/DiffText), ersetzen tokyonights alpha-blendete Defaults. textTier neutral-only wie selection/highlight.",
    "add": {
      "$value": "{color.green.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "delete": {
      "$value": "{color.red.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "change": {
      "$value": "{color.blue.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    }
  },
  "syntax": {
    "$type": "color",
    "foreground": {
      "$value": "{text.default}"
    },
    "background": {
      "$value": "{surface.raised}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "comment": {
      "$value": "{ink.lapis}",
      "$extensions": {
        "org.samisdat.syntax": {
          "fontStyle": "italic"
        }
      }
    },
    "keyword": {
      "$value": "{ink.ruby}"
    },
    "string": {
      "$value": "{ink.jade}"
    },
    "string-special": {
      "$value": "{ink.steel}"
    },
    "number": {
      "$value": "{ink.jade}"
    },
    "constant": {
      "$value": "{ink.jade}"
    },
    "function": {
      "$value": "{ink.sapphire}"
    },
    "type": {
      "$value": "{ink.steel}"
    },
    "variable": {
      "$value": "{text.default}"
    },
    "parameter": {
      "$value": "{ink.gold}"
    },
    "property": {
      "$value": "{ink.turquoise}"
    },
    "tag": {
      "$value": "{ink.rose}"
    },
    "tag-attribute": {
      "$value": "{ink.amethyst}"
    },
    "operator": {
      "$value": "{text.secondary}"
    },
    "punctuation": {
      "$value": "{text.secondary}"
    },
    "diff-plus": {
      "$value": "{ink.jade}"
    },
    "diff-minus": {
      "$value": "{ink.ruby}"
    }
  },
  "terminal": {
    "$type": "color",
    "$description": "ANSI-Palette (0-7 normal, 8-15 bright), geteilt für zsh/herdr/nvim (ADR 0019). Aliase auf bestehende Ebene-2-Werte, keine neuen Primitiven. black/white folgen dem jeweils dunkelsten/hellsten Neutralton des Modes (surface im Dark Mode, text im Light Mode); bright-Varianten der Bunttöne nutzen, wo verfügbar, einen zweiten Ink-Ton derselben Farbfamilie, sonst denselben Ton wie normal.",
    "ansi0": {
      "$value": "{text.emphasis}",
      "$description": "black"
    },
    "ansi1": {
      "$value": "{ink.ruby}",
      "$description": "red"
    },
    "ansi2": {
      "$value": "{ink.jade}",
      "$description": "green"
    },
    "ansi3": {
      "$value": "{ink.gold}",
      "$description": "yellow"
    },
    "ansi4": {
      "$value": "{ink.sapphire}",
      "$description": "blue"
    },
    "ansi5": {
      "$value": "{ink.amethyst}",
      "$description": "magenta"
    },
    "ansi6": {
      "$value": "{ink.steel}",
      "$description": "cyan"
    },
    "ansi7": {
      "$value": "{surface.default}",
      "$description": "white"
    },
    "ansi8": {
      "$value": "{text.default}",
      "$description": "bright black"
    },
    "ansi9": {
      "$value": "{ink.copper}",
      "$description": "bright red"
    },
    "ansi10": {
      "$value": "{ink.jade}",
      "$description": "bright green (keine zweite Grün-Ink verfügbar, identisch mit ansi2)"
    },
    "ansi11": {
      "$value": "{ink.gold}",
      "$description": "bright yellow (keine zweite Gelb-Ink verfügbar, identisch mit ansi3)"
    },
    "ansi12": {
      "$value": "{ink.sapphire}",
      "$description": "bright blue (keine zweite Blau-Ink verfügbar, identisch mit ansi4)"
    },
    "ansi13": {
      "$value": "{ink.rose}",
      "$description": "bright magenta"
    },
    "ansi14": {
      "$value": "{ink.turquoise}",
      "$description": "bright cyan"
    },
    "ansi15": {
      "$value": "{surface.raised}",
      "$description": "bright white"
    }
  }
}
