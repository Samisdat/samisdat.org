{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{color.ivory.200}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "emphasis": {
      "$value": "{color.ivory.600}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "raised": {
      "$value": "{color.ivory.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "subtle": {
      "$value": "{color.ivory.400}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "muted": {
      "$value": "{color.ivory.500}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only",
          "exempt": "no text on this surface; border.* tokens now own all border and scroll-progress uses"
        }
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.aubergine.900}"
    },
    "emphasis": {
      "$value": "{color.aubergine.950}"
    },
    "secondary": {
      "$value": "{color.aubergine.800}"
    },
    "subtle": {
      "$value": "{color.aubergine.700}"
    },
    "muted": {
      "$value": "{color.ivory.700}"
    }
  },
  "ink": {
    "$type": "color",
    "red": {
      "$value": "{color.red.800}"
    },
    "orange": {
      "$value": "{color.orange.800}"
    },
    "yellow": {
      "$value": "{color.yellow.800}"
    },
    "green": {
      "$value": "{color.green.800}"
    },
    "teal": {
      "$value": "{color.teal.800}"
    },
    "cyan": {
      "$value": "{color.cyan.900}"
    },
    "blue": {
      "$value": "{color.blue.700}"
    },
    "purple": {
      "$value": "{color.purple.800}"
    },
    "pink": {
      "$value": "{color.pink.800}"
    },
    "comment": {
      "$value": "{color.periwinkle.700}"
    }
  },
  "status": {
    "$type": "color",
    "danger": {
      "$value": "{ink.red}"
    },
    "warning": {
      "$value": "{ink.orange}"
    },
    "success": {
      "$value": "{ink.green}"
    },
    "info": {
      "$value": "{ink.blue}"
    }
  },
  "border": {
    "$type": "color",
    "muted": {
      "$value": "{surface.muted}"
    },
    "default": {
      "$value": "{color.ivory.700}"
    },
    "strong": {
      "$value": "{color.aubergine.700}"
    },
    "focus": {
      "$value": "{ink.teal}"
    }
  },
  "selection": {
    "$type": "color",
    "$value": "{color.aubergine.100}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "neutral-only"
      }
    }
  },
  "highlight": {
    "$type": "color",
    "$value": "{color.aubergine.50}",
    "$extensions": {
      "org.samisdat.a11y": {
        "textTier": "neutral-only"
      }
    }
  },
  "diff": {
    "$type": "color",
    "$description": "Opake nvim-Diff-Hintergründe (DiffAdd/DiffDelete, DiffChange/DiffText), ersetzen tokyonights alpha-blendete Defaults. textTier neutral-only wie selection/highlight.",
    "add": {
      "$value": "{color.green.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "delete": {
      "$value": "{color.red.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    },
    "change": {
      "$value": "{color.blue.100}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "neutral-only"
        }
      }
    }
  },
  "syntax": {
    "$type": "color",
    "foreground": {
      "$value": "{text.default}"
    },
    "background": {
      "$value": "{surface.raised}",
      "$extensions": {
        "org.samisdat.a11y": {
          "textTier": "full"
        }
      }
    },
    "comment": {
      "$value": "{ink.comment}",
      "$extensions": {
        "org.samisdat.syntax": {
          "fontStyle": "italic"
        }
      }
    },
    "keyword": {
      "$value": "{ink.red}"
    },
    "string": {
      "$value": "{ink.green}"
    },
    "string-special": {
      "$value": "{ink.cyan}"
    },
    "number": {
      "$value": "{ink.green}"
    },
    "constant": {
      "$value": "{ink.green}"
    },
    "function": {
      "$value": "{ink.blue}"
    },
    "type": {
      "$value": "{ink.cyan}"
    },
    "variable": {
      "$value": "{text.default}"
    },
    "parameter": {
      "$value": "{ink.yellow}"
    },
    "property": {
      "$value": "{ink.teal}"
    },
    "tag": {
      "$value": "{ink.pink}"
    },
    "tag-attribute": {
      "$value": "{ink.purple}"
    },
    "operator": {
      "$value": "{text.secondary}"
    },
    "punctuation": {
      "$value": "{text.secondary}"
    },
    "diff-plus": {
      "$value": "{ink.green}"
    },
    "diff-minus": {
      "$value": "{ink.red}"
    }
  },
  "terminal": {
    "$type": "color",
    "$description": "ANSI-Palette (0-7 normal, 8-15 bright), geteilt für zsh/herdr/nvim (ADR 0019). Aliase auf bestehende Ebene-2-Werte, keine neuen Primitiven. black/white folgen dem jeweils dunkelsten/hellsten Neutralton des Modes (surface im Dark Mode, text im Light Mode); bright-Varianten der Bunttöne nutzen, wo verfügbar, einen zweiten Ink-Ton derselben Farbfamilie, sonst denselben Ton wie normal.",
    "ansi0": {
      "$value": "{text.emphasis}",
      "$description": "black"
    },
    "ansi1": {
      "$value": "{ink.red}",
      "$description": "red"
    },
    "ansi2": {
      "$value": "{ink.green}",
      "$description": "green"
    },
    "ansi3": {
      "$value": "{ink.yellow}",
      "$description": "yellow"
    },
    "ansi4": {
      "$value": "{ink.blue}",
      "$description": "blue"
    },
    "ansi5": {
      "$value": "{ink.purple}",
      "$description": "magenta"
    },
    "ansi6": {
      "$value": "{ink.cyan}",
      "$description": "cyan"
    },
    "ansi7": {
      "$value": "{surface.default}",
      "$description": "white"
    },
    "ansi8": {
      "$value": "{text.default}",
      "$description": "bright black"
    },
    "ansi9": {
      "$value": "{ink.orange}",
      "$description": "bright red"
    },
    "ansi10": {
      "$value": "{ink.green}",
      "$description": "bright green (keine zweite Grün-Ink verfügbar, identisch mit ansi2)"
    },
    "ansi11": {
      "$value": "{ink.yellow}",
      "$description": "bright yellow (keine zweite Gelb-Ink verfügbar, identisch mit ansi3)"
    },
    "ansi12": {
      "$value": "{ink.blue}",
      "$description": "bright blue (keine zweite Blau-Ink verfügbar, identisch mit ansi4)"
    },
    "ansi13": {
      "$value": "{ink.pink}",
      "$description": "bright magenta"
    },
    "ansi14": {
      "$value": "{ink.teal}",
      "$description": "bright cyan"
    },
    "ansi15": {
      "$value": "{surface.raised}",
      "$description": "bright white"
    }
  }
}
