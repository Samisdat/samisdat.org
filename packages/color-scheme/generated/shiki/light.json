{
  "name": "samisdat",
  "fg": "#1e142e",
  "bg": "#f9f2ee",
  "colors": {
    "editor.foreground": "#1e142e",
    "editor.background": "#f9f2ee"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#014ce6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c02000"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "markup.inline.raw"],
      "settings": {
        "foreground": "#047233"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#475e5f"
      }
    },
    {
      "scope": ["constant.numeric", "keyword.other.unit"],
      "settings": {
        "foreground": "#047233"
      }
    },
    {
      "scope": ["constant", "constant.language", "support.constant", "variable.other.constant", "variable.language"],
      "settings": {
        "foreground": "#047233"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.method",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#236792"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#475e5f"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#1e142e"
      }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters variable"],
      "settings": {
        "foreground": "#8b5f01"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#087473"
      }
    },
    {
      "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#ae01b3"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#754db2"
      }
    },
    {
      "scope": ["keyword.operator", "storage.type.function.arrow"],
      "settings": {
        "foreground": "#45385b"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter", "punctuation.definition.template-expression"],
      "settings": {
        "foreground": "#45385b"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#047233"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#c02000"
      }
    }
  ],
  "type": "light"
}
