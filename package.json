{
  "name": "samisdat-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:lib": "pnpm --filter @samisdat/wtal-panorama build:lib",
    "dev:app": "pnpm --filter @samisdat/wtal-panorama dev",
    "dev:lib": "pnpm --filter @samisdat/wtal-panorama dev:lib",
    "dev": "pnpm --filter @samisdat/website dev",
    "dev:all": "concurrently \"pnpm dev:lib\" \"pnpm dev\"",
    "build": "pnpm run build:lib && pnpm --filter @samisdat/website build",
    "storybook": "pnpm --filter @samisdat/ui-components storybook",
    "build-storybook": "pnpm --filter @samisdat/ui-components build-storybook",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:css": "stylelint \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "test": "pnpm -r test",
    "lint:colors": "./scripts/lint-colors.sh",
    "lint:tokens": "pnpm --filter @samisdat/color-scheme build && pnpm --filter @samisdat/color-scheme lint && git diff --exit-code -- packages/color-scheme/generated && test -z \"$(git ls-files --others --exclude-standard -- packages/color-scheme/generated)\"",
    "dev:tokens": "pnpm --filter @samisdat/color-scheme dev",
    "check:versions": "syncpack lint",
    "fix:versions": "syncpack fix-mismatches",
    "deploy:preview": "vercel deploy",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.73.0",
    "postcss-styled-syntax": "^0.7.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "syncpack": "^15.3.3"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
